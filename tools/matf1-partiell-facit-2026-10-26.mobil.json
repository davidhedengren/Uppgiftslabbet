{
"\\int x^2e^{-2x}\\,dx=-\\frac12x^2e^{-2x}+\\int xe^{-2x}\\,dx.": "\\begin{aligned}\\int x^2e^{-2x}\\,dx\\\\=-\\frac12x^2e^{-2x}+\\int xe^{-2x}\\,dx.\\end{aligned}",
"\\int xe^{-2x}\\,dx=-\\frac12xe^{-2x}+\\frac12\\int e^{-2x}\\,dx.": "\\begin{aligned}\\int xe^{-2x}\\,dx\\\\=-\\frac12xe^{-2x}+\\frac12\\int e^{-2x}\\,dx.\\end{aligned}",
"\\int x^2e^{-2x}\\,dx=-e^{-2x}\\left(\\frac{x^2}{2}+\\frac{x}{2}+\\frac14\\right)+C.": "\\begin{aligned}\\int x^2e^{-2x}\\,dx\\\\=-e^{-2x}\\left(\\frac{x^2}{2}+\\frac{x}{2}+\\frac14\\right)+C.\\end{aligned}",
"(-e^{-2x}P(x))\\prime=e^{-2x}(2P(x)-P\\prime(x)).": "\\begin{aligned}(-e^{-2x}P(x))\\prime\\\\=e^{-2x}(2P(x)-P\\prime(x)).\\end{aligned}",
"\\left(e^x(x-1)\\right)\\prime=e^x(x-1)+e^x=xe^x.": "\\begin{aligned}\\left(e^x(x-1)\\right)\\prime\\\\=e^x(x-1)+e^x=xe^x.\\end{aligned}",
"\\int x\\cos x\\,dx=x\\sin x-\\int\\sin x\\,dx": "\\begin{aligned}\\int x\\cos x\\,dx\\\\=x\\sin x-\\int\\sin x\\,dx\\end{aligned}",
"\\int x\\sin x\\,dx=-x\\cos x+\\int\\cos x\\,dx": "\\begin{aligned}\\int x\\sin x\\,dx\\\\=-x\\cos x+\\int\\cos x\\,dx\\end{aligned}",
"\\int x^2\\sin(2x)\\,dx=-\\frac{x^2\\cos(2x)}2+J": "\\begin{aligned}\\int x^2\\sin(2x)\\,dx\\\\=-\\frac{x^2\\cos(2x)}2+J\\end{aligned}",
"F(x)=xe^x-\\int e^x\\,dx=(x-1)e^x.": "\\begin{aligned}F(x)&=xe^x-\\int e^x\\,dx\\\\&=(x-1)e^x.\\end{aligned}",
"\\int x\\ln x\\,dx=\\frac{x^2\\ln x}2-\\frac12\\int x\\,dx": "\\begin{aligned}\\int x\\ln x\\,dx\\\\=\\frac{x^2\\ln x}2-\\frac12\\int x\\,dx\\end{aligned}",
"I=\\int x^2\\sin x\\,dx=-x^2\\cos x+2J": "\\begin{aligned}I&=\\int x^2\\sin x\\,dx\\\\&=-x^2\\cos x+2J\\end{aligned}",
"I=-x^2\\cos x+2(x\\sin x+\\cos x)+C": "\\begin{aligned}I={}&-x^2\\cos x\\\\&+2(x\\sin x+\\cos x)+C\\end{aligned}",
"J=x\\ln x-\\int1\\,dx=x\\ln x-x.": "\\begin{aligned}J&=x\\ln x-\\int1\\,dx\\\\&=x\\ln x-x.\\end{aligned}",
"I=x(\\ln x)^2-2(x\\ln x-x)+C": "\\begin{aligned}I={}&x(\\ln x)^2\\\\&-2(x\\ln x-x)+C\\end{aligned}",
"F(x)=\\frac{x\\sin(3x)}3-\\frac13\\int\\sin(3x)\\,dx": "\\begin{aligned}F(x)={}&\\frac{x\\sin(3x)}3\\\\&-\\frac13\\int\\sin(3x)\\,dx\\end{aligned}",
"F\\prime(x)=\\frac{\\sin(3x)}3+x\\cos(3x)-\\frac{\\sin(3x)}3": "\\begin{aligned}F\\prime(x)={}&\\frac{\\sin(3x)}3+x\\cos(3x)\\\\&-\\frac{\\sin(3x)}3\\end{aligned}",
"=-\\frac{x\\cos(3x)}3+\\frac13\\cdot\\frac{\\sin(3x)}3+C": "\\begin{aligned}={}&-\\frac{x\\cos(3x)}3\\\\&+\\frac13\\cdot\\frac{\\sin(3x)}3+C\\end{aligned}",
"\\int\\ln(3x)\\,dx=x\\ln(3x)-\\int\\frac1x\\cdot x\\,dx": "\\begin{aligned}\\int\\ln(3x)\\,dx\\\\=x\\ln(3x)-\\int\\frac1x\\cdot x\\,dx\\end{aligned}",
"I=\\int x^2\\cos x\\,dx=x^2\\sin x-2J": "\\begin{aligned}I&=\\int x^2\\cos x\\,dx\\\\&=x^2\\sin x-2J\\end{aligned}",
"I=x^2\\sin x-2(-x\\cos x+\\sin x)+C": "\\begin{aligned}I={}&x^2\\sin x\\\\&-2(-x\\cos x+\\sin x)+C\\end{aligned}",
"\\int\\ln x\\,dx=x\\ln x-\\int1\\,dx=x\\ln x-x.": "\\begin{aligned}\\int\\ln x\\,dx&=x\\ln x-\\int1\\,dx\\\\&=x\\ln x-x.\\end{aligned}",
"\\int_1^e(\\ln x)^2\\,dx=F(e)-F(1)=e-2": "\\begin{aligned}\\int_1^e(\\ln x)^2\\,dx\\\\=F(e)-F(1)=e-2\\end{aligned}",
"F(x)=-(x+2)\\cos x+\\int\\cos x\\,dx": "\\begin{aligned}F(x)={}&-(x+2)\\cos x\\\\&+\\int\\cos x\\,dx\\end{aligned}",
"F(x)=-\\frac{x\\cos(2x)}2+\\frac12\\int\\cos(2x)\\,dx": "\\begin{aligned}F(x)={}&-\\frac{x\\cos(2x)}2\\\\&+\\frac12\\int\\cos(2x)\\,dx\\end{aligned}",
"F(\\pi/2)=-\\frac{(\\pi/2)(-1)}2+0=\\frac\\pi4": "\\begin{aligned}F(\\pi/2)&=-\\frac{(\\pi/2)(-1)}2+0\\\\&=\\frac\\pi4\\end{aligned}"
}
